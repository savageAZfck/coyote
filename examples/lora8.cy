// lora8.cy — TRUE rank-8 LoRA on silicon, via a masked bottleneck.
//
// The ANE skeleton table forces dim ≥ 64 on every adapter matmul —
// but the rank doesn't live in the shape, it lives in the data. `sel`
// is a rank-selector vector (generated by `coyote-apple genmask`):
// `(x @ la) * sel` zeroes every coordinate ≥ 8, so lb's dead rows
// see zero inputs — and the backward pass gives la's masked columns
// exactly zero gradient. Only la[:, 0:8] and lb[0:8, :] ever move.
// Forward, backward, and adam all stay inside the same ANE binary.
//
//   coyote-apple genmask sel:8:64 -o mask.safetensors
//   coyote run examples/lora8.cy -o out/lora8 --steps 20

invariant never_sells_self

provenance {
    author: "savage"
    purpose: "masked-rank LoRA — structured sparsity on ANE"
}

param w:   frozen    f16[64, 64]
param la:  trainable f16[64, 64]
param lb:  trainable f16[64, 64]
param sel: frozen    f16[64] @ "mask.safetensors::sel"

io x: in f16[64]
io t: in f16[64]
io y: out f16[64]

fn adapt(
    x: f16[64], w: f16[64, 64], la: f16[64, 64],
    lb: f16[64, 64], sel: f16[64]
) -> f16[64] {
    (x @ w) + (relu((x @ la) * sel) @ lb)
}

fn loss(
    x: f16[64], t: f16[64], w: f16[64, 64],
    la: f16[64, 64], lb: f16[64, 64], sel: f16[64]
) -> f32 {
    mse(adapt(x, w, la, lb, sel), t)
}

fn main(x: f16[64], t: f16[64]) -> f16[64] {
    adam(la, grad(loss(x, t, w, la, lb, sel), la), 0.01);
    adam(lb, grad(loss(x, t, w, la, lb, sel), lb), 0.01);
    adapt(x, w, la, lb, sel)
}
